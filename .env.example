# ── sync.js API keys ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Then run:  source .env && node sync.js

# The Odds API — https://the-odds-api.com
# Free tier: 500 requests/month (plenty for daily runs)
# Provides: live odds for all upcoming WC matches
ODDS_API_KEY=your_key_here

# football-data.org — https://football-data.org
# Free tier: requires free registration, 10 req/min
# Provides: official WC fixture list (detects newly confirmed matches)
FOOTBALL_DATA_KEY=your_key_here

# Anthropic Claude API — https://console.anthropic.com
# Optional: only needed for auto-generating DE/TR preview text on NEW matches
# If not set, new matches get plain English stub previews you can edit later
ANTHROPIC_API_KEY=your_key_here
